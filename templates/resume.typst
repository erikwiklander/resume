#set terms(hanging-indent: 1.5em)

#set document(
  title: $if(title)$[$title$]$else$[Resume]$endif$,
  author: "Erik Wiklander",
)

#set page(
  paper: "us-letter",
  margin: (
    top: 0.56in,
    bottom: 0.58in,
    left: 0.62in,
    right: 0.62in,
  ),
  numbering: none,
)

#let accent = rgb("#2f6077")
#let muted = rgb("#5e6976")
#let rule = rgb("#d8dee2")

#set text(
  font: "Arial",
  size: 10pt,
  fill: rgb("#17201f"),
)

#set par(
  leading: 0.30em,
  spacing: 5pt,
  justify: false,
)

#set list(
  indent: 0.20in,
  body-indent: 0.10in,
  spacing: 4.2pt,
  marker: text(fill: accent)[•],
)

#set enum(
  indent: 0.20in,
  body-indent: 0.10in,
  spacing: 4.2pt,
)

#set table(
  inset: (x: 0pt, y: 6pt),
  stroke: none,
  gutter: 24pt,
  align: left,
)

#show link: it => text(fill: rgb("#111111"))[#it.body]

#show strong: it => text(weight: "bold")[#it.body]

#show heading.where(level: 1): it => block(above: 0pt, below: 2pt, breakable: false)[
  #text(size: 27pt, weight: "bold", hyphenate: false)[#it.body]
]

#show heading.where(level: 2): it => block(above: 16pt, below: 7pt, breakable: false)[
  #text(size: 11.2pt, weight: "bold", fill: accent, tracking: 0.08em, hyphenate: false)[#it.body]
  #v(4pt)
  #line(length: 100%, stroke: 0.55pt + rule)
]

#show heading.where(level: 3): it => block(above: 11pt, below: 3pt, breakable: false)[
  #text(size: 10.6pt, weight: "bold", hyphenate: false)[#it.body]
]

#show par: it => {
  let body = it.body
  if body == [] {
    it
  } else {
    it
  }
}

#grid(
  columns: (1fr, auto),
  column-gutter: 24pt,
  align: (left, top),
  [
    #text(size: 27pt, weight: "bold", hyphenate: false)[$name$]
    #v(2pt)
    #text(size: 11.3pt, weight: "bold", fill: accent, hyphenate: false)[$headline$]
  ],
  [
    #align(right)[
      #text(size: 8.7pt, fill: muted)[
        $location$ · $phone$ \
        $email$ · #link("$linkedin$")[linkedin.com/in/ewiklander]
      ]
    ]
  ],
)

#v(11pt)

$body$
